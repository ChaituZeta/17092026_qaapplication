{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@server/*": [
        "./server/*"
      ],
      "@routes/*": [
        "./server/routes/*"
      ],
      "server/routes": [
        "./server/routes/index.ts"
      ],
      "server/routes/*": [
        "./server/routes/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
